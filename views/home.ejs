<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CrazyGames </title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>

body{
    margin:0;
    background:#0f1724;
    font-family: Inter, sans-serif;
    color:white;
    display:flex;
}

.sidebar{
    width:260px;
    background:#141b2d;
    height:100vh;
    padding:20px 18px;
    box-sizing:border-box;
    border-right:1px solid rgba(255,255,255,0.08);
}

.logo{
    font-size:22px;
    font-weight:700;
    margin-bottom:25px;
}


.cat{
    padding:12px 16px;
    margin:6px 0;
    border-radius:10px;
    cursor:pointer;
    font-size:16px;
    color:#c5d1dd;
    display:flex;
    align-items:center;
    gap:10px;
}

.cat:hover{
    background:rgba(255,255,255,0.07);
}

.main{
    flex:1;
}

.navbar{
    width:100%;
    background:#1a2134;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:12px 22px;
    box-sizing:border-box;
    border-bottom:1px solid rgba(255,255,255,0.08);
}

.nav-left{
    display:flex;
    align-items:center;
    gap:12px;
}

.nav-left img{
    width:42px;
    height:42px;
    border-radius:10px;
}

.nav-right{
    display:flex;
    align-items:center;
    gap:18px;
}


.icon-btn{
    background:none;
    border:none;
    color:white;
    font-size:22px;
    cursor:pointer;
    padding:4px 8px;
}

.icon-btn:hover{
    color:#1fc063;
}

.search-box{
    background:#222a40;
    padding:6px 10px;
    border-radius:30px;
    display:flex;
    align-items:center;
    gap:8px;
    border:1px solid rgba(255,255,255,0.05);
}

.search-box input{
    border:none;
    background:transparent;
    outline:none;
    color:white;
    width:180px;
    font-size:14px;
}

.search-btn{
    background:#1fc063;
    border:none;
    color:white;
    padding:6px 14px;
    border-radius:20px;
    cursor:pointer;
}

.login-btn{
    background:#1a76ff;
    padding:8px 18px;
    border:none;
    border-radius:18px;
    color:white;
    cursor:pointer;
    font-weight:600;
}
.login-btn:hover{
    background:#0f5ad4;
}

    .box-container {
        width: 90%;
        margin: 20px auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
    }

    .card {
        border-radius: 20px;
        height: 200px;
        padding: 15px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        
    }

</style>
</head>

<body>

<div class="sidebar">
    <div class="logo">CrazyGames</div>

    <div class="cat"><i class="bi bi-house-door"></i> Popular</div>
    <div class="cat"><i class="bi bi-people"></i> 2 Player</div>
    <div class="cat"><i class="bi bi-compass"></i> Adventure</div>
    <div class="cat"><i class="bi bi-car-front"></i> Car</div>
    <div class="cat"><i class="bi bi-bicycle"></i> Bike</div>
    <div class="cat"><i class="bi bi-basketball"></i> Basketball</div>
    <div class="cat"><i class="bi bi-layers"></i> Card</div>
    <div class="cat"><i class="bi bi-puzzle"></i> Puzzle</div>
    <div class="cat"><i class="bi bi-lightning-charge"></i> Action</div>
</div>

<div class="main">

    <div class="navbar">
        
        <div class="nav-left">
        <img src="./image/logo-ziggy.svg" alt="logo">
            <h2 style="margin:0;">Welcome to CrazyGames</h2>
        </div>

        <div class="nav-right">

            <button class="icon-btn"><i class="bi bi-heart"></i></button>
            <button class="icon-btn"><i class="bi bi-bell"></i></button>

            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search games...">
                <button class="search-btn">Search</button>
            </div>

            <button class="login-btn">Login</button>
        </div>
    </div>
 
 <div class="box-container">
  <a href="/whackamole" class="card">
     <img src="/image/whack.png" width="185" height="210">
  </a>

  <a href="/tictactoe" class="card">
     <img src="/image/tictactoe.png" width="185" height="210">
  </a>

  <a href="/rock" class="card">
     <img src="/image/game3.png" width="185" height="210">
  </a>

  <a href="/subwey" class="card">
     <img src="/image/subwey.png" width="185" height="210">
  </a>
</div>

    
</div>
     </div>

</div>

</body>
</html>
