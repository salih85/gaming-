<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tic Tac Toe</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">

  <style>
    body {
      background-color: #141414;
      overflow-x: hidden;
      color: white;
      font-family: Arial, sans-serif;
    }

    #startScreen {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 2000;
      backdrop-filter: blur(6px);
    }

    #startScreen h1 {
      font-size: 50px;
      font-weight: bold;
      margin-bottom: 20px;
    }

    #startScreen button {
      padding: 12px 32px;
      font-size: 22px;
      background: #ffcc00;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: 0.3s;
    }

    #startScreen button:hover {
      background: #ffaa00;
    }

    .navbar {
      position: relative;
      z-index: 2000 !important;
    }

    #startScreen {
      z-index: 1000 !important;
    }


    .grid-container {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      max-width: 400px;
      margin: auto;
      padding-top: 40px;
    }

    .tile {
      width: 100%;
      height: 120px;
      background: #2d2d2d;
      border-radius: 12px;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      transition: 0.2s;
      overflow: hidden;
    }

    .tile:hover {
      background: #3a3a3a;
    }

    .tile img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    /* Right Box */
    .info-box {
      background: #1f1f1f;
      padding: 30px;
      border-radius: 12px;
      margin-top: 50px;
      text-align: center;
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.05);
    }

    .info-box h1 {
      font-size: 48px;
    }

    @media(max-width: 768px) {
      .info-box {
        margin-top: 25px;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/navbar') %>
    <div id="startScreen">
      <h1>Tic Tac Toe</h1>
      <button onclick="startGame()">Start Game</button>
    </div>

    <div class="container mt-3">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="grid-container">
            <div class="tile"><img id="a1" src="/image/whiteimage.png" onclick="gameClick('a1')"></div>
            <div class="tile"><img id="a2" src="/image/whiteimage.png" onclick="gameClick('a2')"></div>
            <div class="tile"><img id="a3" src="/image/whiteimage.png" onclick="gameClick('a3')"></div>
            <div class="tile"><img id="a4" src="/image/whiteimage.png" onclick="gameClick('a4')"></div>
            <div class="tile"><img id="a5" src="/image/whiteimage.png" onclick="gameClick('a5')"></div>
            <div class="tile"><img id="a6" src="/image/whiteimage.png" onclick="gameClick('a6')"></div>
            <div class="tile"><img id="a7" src="/image/whiteimage.png" onclick="gameClick('a7')"></div>
            <div class="tile"><img id="a8" src="/image/whiteimage.png" onclick="gameClick('a8')"></div>
            <div class="tile"><img id="a9" src="/image/whiteimage.png" onclick="gameClick('a9')"></div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="info-box">
            <h1 id="who">X</h1>
            <h3>TURN</h3>
            <h2 id="winner"></h2>
            <button class="btn btn-success mt-3 p-3" onclick="window.location.reload()">Reset Game</button>
          </div>
        </div>

      </div>
    </div>

    <script>
      var currentplayer = 'x';
      var gameover = false;
      var counter = 0;

      var v = {
        x: '/image/x-o-icon_1076610-58542.avif',
        o: '/image/small-o-icon-vector.jpg'
      };

      function startGame() {
        document.getElementById('startScreen').style.display = 'none';
      }

      function gameClick(imgid) {
        if (gameover) return;

        var img = document.getElementById(imgid);

        if (img.src.includes(v.x) || img.src.includes(v.o)) return;

        img.src = v[currentplayer];

        counter++;

        var winnerCombo = gameCheck();

        if (winnerCombo) {
          gameover = true;
          document.getElementById('winner').innerText = currentplayer.toUpperCase() + " Wins!";
          highlightWinner(winnerCombo);
        } else if (counter === 9) {
          document.getElementById('winner').innerText = "Match Draw!";
        } else {
          currentplayer = currentplayer === 'x' ? 'o' : 'x';
          document.getElementById('who').innerText = currentplayer.toUpperCase();
        }
      }

      function gameCheck() {
        var checks = [
          ['a1', 'a2', 'a3'],
          ['a4', 'a5', 'a6'],
          ['a7', 'a8', 'a9'],
          ['a1', 'a4', 'a7'],
          ['a2', 'a5', 'a8'],
          ['a3', 'a6', 'a9'],
          ['a1', 'a5', 'a9'],
          ['a3', 'a5', 'a7']
        ];

        for (let combo of checks) {
          var [i1, i2, i3] = combo;
          var src1 = document.getElementById(i1).src;
          var src2 = document.getElementById(i2).src;
          var src3 = document.getElementById(i3).src;

          if (src1.includes(v.x) && src2.includes(v.x) && src3.includes(v.x)) {
            return combo;
          }
          if (src1.includes(v.o) && src2.includes(v.o) && src3.includes(v.o)) {
            return combo;
          }
        }

        return null;
      }

      function highlightWinner(combo) {
        combo.forEach(id => {
          let img = document.getElementById(id);
          img.style.border = "3px solid lime";
          img.style.borderRadius = "12px";
        });
      }
    </script>

</body>

</html>