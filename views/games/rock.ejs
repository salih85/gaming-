<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script src="./script.js" defer></script>
    <link rel="stylesheet" href="./style.css">
</head>
<style>
      *{
      margin: 0;
      padding: 0;
      box-sizing: border-box;
   }

    body{
        overflow-x: hidden;
         background-color: #f7f7f7;
        font-family: sans-serif;
    }
    
.layout {
  display: flex;
  height: 100vh;
}

.sidebar-wrapper {
  width: 260px;
  background: #111827; 
  min-height: 100vh;
}

.main-area {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.main-area .navbar {
  position: relative;
  width: 100%;
  z-index: 10;
}

.page-content {
  padding: 20px;
}


    img {
        max-width: 100%;
        height: auto;
    }

    .form1 input {
        width: 100%;
        max-width: 100%;
        padding: 10px;
        border-radius: 5px;
        border: 1px solid #ccc;
    }

    .form1 {
        background-image: url(./image/background.jpg);
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
        width: 100%;
        max-width: 100%;
        height: auto;
        min-height: 300px;
        padding: 30px 15px;
        border-radius: 10px;
    }
    .button{
        color: black;
        font-size: 20px;
        font-weight: bold;
    }

    .form-group {
        text-align: center;
        padding: 1px 70px;

    }
        .flash {
        animation: flash 0.4s ease;
    }

    @keyframes flash {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.2);
            opacity: 0.6;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<body>
<div class="layout">

    <div class="sidebar-wrapper">
        <%- include('../partials/sidebar') %>
    </div>
    <div class="main-area">

        <%- include('../partials/navbar') %>
        <div class="page-content">
    <section>
        <div class="row mt-3 mb-5">
            <div class="col-12">
                <h1 class="text-center">FIND THE CHAMP</h1>
            </div>
        </div>
        <div class="row mb-5">
            <div class="col-6 text-center">
                <img src="./image/rock.png" alt="" id="i1" class="img-fluid" style="height: 160px;">
                <div class="form-group mt-3">
                    <input type="text" name="" id="name1">
                </div>
                <h2 class="text-center" id="score1">0</h2>
  <button class="btn btn-outline-primary btn-choice" onclick="playerChoose('rock')">🪨 Rock</button>
    <button class="btn btn-outline-success btn-choice" onclick="playerChoose('paper')">📄 Paper</button>
    <button class="btn btn-outline-danger btn-choice" onclick="playerChoose('scissor')">✂️ Scissor</button>
            </div>
            <div class="col-6 text-center">
          <img src="./image/rock.png" alt="Computer" id="i2" class="img-fluid" style="height: 160px;" />
          <h2 class="text-center mt-3">Computer</h2>
          <h2 class="text-center" id="score2">0</h2>
        </div>
      </div>

      <div class="row">
        <div class="col-4 offset-4 mt-2">
          <h4 class="text-center mt-3" id="currentRound"></h4>
        </div>
      </div>
    </section>

    <section id="overlay"
      style="background-color: rgba(0,0,0,0.95); width: 100%; height: 100vh; position: absolute; top: 0; padding-top: 100px;">
      <h1 class="text-center text-white mt-3">WELCOME</h1>
      <h2 class="text-center text-info mt-3">ROCK PAPER SCISSOR CHAMP 2025</h2>

      <div class="row mt-5 btn1">
        <div class="col-12 col-md-6 col-lg-4 offset-md-3 offset-lg-4 form1">
          <div class="form-group mt-4">
            <input type="text" id="n1" class="text-align" placeholder="Enter Your Name">
          </div>
          <button class="btn btn-block btn-outline-warning mt-5 button" onclick="startGame()">START THE GAME</button>
        </div>
      </div>
    </section>
     </div>
      </div>

    <section class="text-center" id="overlay2"
      style="background-color: rgba(0, 0, 0, 0.95); width: 100%; height: 100vh; position: absolute; top: 0; padding-top: 40vh; display: none;">
      <h1 class="text-center text-white mt-5" id="winner"></h1>
      <button onclick="resetGame()" class="btn btn-outline-primary mt-5">RESTART GAME</button>
    </section>
  </div>
  <script>
      const i1 = document.getElementById("i1");
const i2 = document.getElementById("i2");

const attacks = [
  { attack: "rock", image: "./image/rock.png" },
  { attack: "paper", image: "./image/paper.png" },
  { attack: "scissor", image: "./image/scissors.png" },
];

let score1 = 0;
let score2 = 0;
let currentRound = 0;
const maxRounds = 20;

document.getElementById("overlay2").style.display = "none";

function startGame() {
  const name = document.getElementById("n1").value.trim();
  if (name === "") {
    alert("Please enter your name!");
    return;
  }

  document.getElementById("name1").value = name;
  document.getElementById("overlay").style.display = "none";
}

function playerChoose(playerAttack) {
  const playerName = document.getElementById("name1").value.trim();
  if (playerName === "") {
    alert("Enter your name first!");
    return;
  }

  const playerIndex = attacks.findIndex((a) => a.attack === playerAttack);
  const computerIndex = Math.floor(Math.random() * 3);

  i1.src = attacks[playerIndex].image;
  i2.src = attacks[computerIndex].image;

  i1.classList.remove("flash");
  i2.classList.remove("flash");

  const computerAttack = attacks[computerIndex].attack;

  if (playerAttack !== computerAttack) {
    if (
      (playerAttack === "rock" && computerAttack === "scissor") ||
      (playerAttack === "scissor" && computerAttack === "paper") ||
      (playerAttack === "paper" && computerAttack === "rock")
    ) {
      score1++;
      i1.classList.add("flash");
    } else {
      score2++;
      i2.classList.add("flash");
    }
  }

  currentRound++;
  document.getElementById("score1").innerText = score1;
  document.getElementById("score2").innerText = score2;
  document.getElementById("currentRound").innerText =
    `Round: ${currentRound}/${maxRounds}`;

  if (currentRound >= maxRounds) {
    gameOver();
  }
}

function gameOver() {
  const name = document.getElementById("name1").value;
  const winnerText = document.getElementById("winner");

  if (score1 > score2) {
    winnerText.innerText = `${name} 🎉 WON!`;
  } else if (score2 > score1) {
    winnerText.innerText = `Computer 🎉 WON!`;
  } else {
    winnerText.innerText = `DRAW GAME`;
  }

  document.getElementById("overlay2").style.display = "block";

  confetti({
    particleCount: 150,
    spread: 100,
    origin: { y: 0.6 },
  });
}

function resetGame() {
  score1 = 0;
  score2 = 0;
  currentRound = 0;

  document.getElementById("score1").innerText = "0";
  document.getElementById("score2").innerText = "0";
  document.getElementById("currentRound").innerText = "";
  document.getElementById("winner").innerText = "";
  document.getElementById("overlay2").style.display = "none";
  document.getElementById("name1").value = "";
  document.getElementById("overlay").style.display = "block";
  document.getElementById("n1").value = "";
}
  </script>
  </body>
  </html>