<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Whack-a-Mole</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      background-color: #f0f8ff;
      margin: 0;
      padding: 20px;
    }

    .layout {
      display: flex;
      height: 100vh;
    }

    .sidebar-wrapper {
      width: 260px;
      background: #111827;
      min-height: 100vh;
    }

    .main-area {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .main-area .navbar {
      position: relative;
      width: 100%;
      z-index: 10;
    }

    .page-content {
      padding: 20px;
    }

    h1 {
      margin-bottom: 20px;
    }

    .game-container {
      display: grid;
      grid-template-columns: repeat(4, 120px);
      gap: 20px;
      justify-content: center;
      margin-top: 30px;
    }

    .hole {
      width: 120px;
      height: 120px;
      background-color: #ddd;
      border-radius: 10px;
      position: relative;
      cursor: url("/image/hammer-cursor.png") 0 0, pointer;
      transition: background 0.2s ease-in-out;
    }


    .mole {
      width: 80px;
      height: 80px;
      background-image: url("./image/whackmole.png");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      position: absolute;
      top: 20px;
      left: 20px;
      display: none;
    }


    .hole.active .mole {
      display: block;
    }

    #score {
      font-size: 24px;
      margin-top: 20px;
    }

    #startBtn {
      margin-top: 20px;
      padding: 10px 20px;
      font-size: 18px;
      cursor: pointer;
    }


    #gameOverOverlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }

    #gameOverBox {
      background: white;
      padding: 30px;
      border-radius: 10px;
      text-align: center;
      width: 300px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    #closeOverlay {
      margin-top: 15px;
      padding: 8px 20px;
      cursor: pointer;
      font-size: 16px;
    }
  </style>

</head>

<body>

  <div class="layout">

    <div class="sidebar-wrapper">
      <%- include('../partials/sidebar'); %>
    </div>

    <div class="main-area">
      <%- include('../partials/navbar'); %>

        <div class="page-content">

          <h1>Whack-a-Mole Game</h1>
          <button id="startBtn">Start Game</button>
          <div id="score">Score: 0</div>

          <div class="game-container">
            <div class="hole" onclick="whack(this)">
              <div class="mole"></div>
            </div>
            <div class="hole" onclick="whack(this)">
              <div class="mole"></div>
            </div>
            <div class="hole" onclick="whack(this)">
              <div class="mole"></div>
            </div>
            <div class="hole" onclick="whack(this)">
              <div class="mole"></div>
            </div>
            <div class="hole" onclick="whack(this)">
              <div class="mole"></div>
            </div>
            <div class="hole" onclick="whack(this)">
              <div class="mole"></div>
            </div>
            <div class="hole" onclick="whack(this)">
              <div class="mole"></div>
            </div>
            <div class="hole" onclick="whack(this)">
              <div class="mole"></div>
            </div>
          </div>

        </div>
    </div>

  </div>


  <div id="gameOverOverlay">
    <div id="gameOverBox">
      <h2>Time's Up!</h2>
      <p id="finalScoreText">Your Score: 0</p>
      <button id="closeOverlay">Close</button>
    </div>
  </div>


  <script>
    let score = 0;
    let currentHole = null;
    let gameInterval = null;

    function randomHole() {
      const holes = document.querySelectorAll('.hole');
      holes.forEach(h => h.classList.remove('active'));

      const index = Math.floor(Math.random() * holes.length);
      currentHole = holes[index];
      currentHole.classList.add('active');
    }

    function startGame() {
      score = 0;
      document.getElementById('score').innerText = "Score: 0";

      if (gameInterval) clearInterval(gameInterval);
      gameInterval = setInterval(randomHole, 1000);

      setTimeout(() => {
        clearInterval(gameInterval);

        document.getElementById("finalScoreText").innerText =
          "Your Score: " + score;

        document.getElementById("gameOverOverlay").style.display = "flex";

        const holes = document.querySelectorAll('.hole');
        holes.forEach(h => h.classList.remove('active'));

      }, 20000);
    }

    function whack(hole) {
      if (hole.classList.contains('active')) {
        score++;
        document.getElementById('score').innerText = "Score: " + score;
        hole.classList.remove('active');
      }
    }

    document.getElementById('startBtn').addEventListener('click', startGame);

    document.getElementById("closeOverlay").addEventListener("click", () => {
      document.getElementById("gameOverOverlay").style.display = "none";
    });

  </script>

</body>

</html>